{
  // Self-contained compiler settings: types resolve from the @deepseek-ai/*
  // npm SDK packages declared in devDependencies (official NPM SDK), never
  // from a DSH source checkout.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "incremental": true,
    // Type-check cache lives outside `lib` so it can never be mistaken for a
    // shipped artifact (the packaging check compares `lib` against the
    // tarball, and npm correctly excludes a stray .tsbuildinfo).
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.typecheck.tsbuildinfo",
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
